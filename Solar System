Triple
Triple::operator+ ( Triple e) {
    return Triple(x+e.x, y+e.y, z+e.z);
}

double
Triple::operator* ( Triple that) {
    return x * that.x + (*this).y * that.y + this->z * that.z;
}


Triple
Triple::operator* (float m) {
    return Triple(x*m, y*m, z*m);
}


Triple
Triple::operator- ( Triple d) {
  return Triple(x-d.x, y-d.y, z-d.z);
}

bool
Triple::operator== ( Triple d) {
  return bool(d.x == x &&
            d.y == y &&
            d.z == z
            );
}
