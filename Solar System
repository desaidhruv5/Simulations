Field
fieldat(Position r, std::vector<Particle> vp) {
  
  Field f(Triple(0,0,0));

  for (size_t n = 0; n < vp.size(); n++) {
    Field df = vp[n].fieldat(r);
    f = f + df;
    if (0) 
      std::cout << " at position " << r.x
    << " field due to " << vp[n].pID << " dfx = " << df.x
    << " fx = " << f.x
    << std::endl;
  }

  return f;
}



